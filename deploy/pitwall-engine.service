[Unit]
Description=Pitwall engine (strategies, broker, risk halts)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pitwall
WorkingDirectory=/home/pitwall/pitwall
EnvironmentFile=/home/pitwall/pitwall/.env
ExecStart=/usr/bin/node src/engine/main.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
