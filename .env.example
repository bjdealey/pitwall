# Copy to .env and fill in. Both processes read it (systemd EnvironmentFile on the Pi).

# SQLite file shared by the engine and the API. The directory is created on start.
PITWALL_DB=./data/pitwall.db

# sim runs a local random-walk broker. alpaca talks to Alpaca with the keys below.
PITWALL_BROKER=sim

# Only "true" together with PITWALL_BROKER=alpaca trades real money on the live endpoint.
# Anything else uses Alpaca's paper endpoint. The dashboard shows LIVE or PAPER; it cannot switch.
PITWALL_LIVE=false
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Comma-separated <strategy-id>:<SYMBOL>. Ids are kebab-case and appear verbatim in the UI. One strategy per symbol.
PITWALL_STRATEGIES=sma-cross-spy:SPY,sma-cross-qqq:QQQ

# Automatic halts. Daily loss is percent of yesterday's closing equity.
PITWALL_DAILY_LOSS_PCT=2
PITWALL_MAX_REJECTIONS=4
PITWALL_BROKER_SILENCE_S=30

# Entry window, in minutes after the open and before the close. A delay of 31 is 10:01 ET,
# the first time all 31 bars the strategy reads are from today.
PITWALL_ENTRY_DELAY_MIN=31
PITWALL_ENTRY_CUTOFF_MIN=30
# Sell each position this many minutes before the close, early closes included.
PITWALL_FLAT_BEFORE_CLOSE_MIN=5
# Sell a position this percent below its average entry price. The minimum is 0.05.
PITWALL_STOP_PCT=1
# Sizing, in percent of equity: what one stop-out may lose, the largest position, and the cash kept back.
PITWALL_RISK_PCT=1
PITWALL_MAX_POSITION_PCT=75
PITWALL_CASH_BUFFER_PCT=10
# New entries per day across all strategies. Reaching it blocks entries only and does not halt.
PITWALL_MAX_TRADES_PER_DAY=3

# From: printf %s "$PASSCODE" | npm run -s hash-passcode   (keep the single quotes)
PITWALL_PASSCODE_HASH=
# At least 32 random characters, e.g. from: openssl rand -base64 48
PITWALL_SESSION_SECRET=

# API port on 127.0.0.1. tailscale serve proxies HTTPS to it.
PORT=8080

# Optional ntfy topic for halt, error and engine-down alerts, e.g. https://ntfy.sh/my-topic
NTFY_URL=

# Nightly backup destination for deploy/pitwall-backup.service (rsync target).
PITWALL_BACKUP_TARGET=
